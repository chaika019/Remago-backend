# ============================================================
# REMAGO FLOW backend environment
# Copy this file to .env and fill in secrets locally.
# Never commit the real .env file.
# ============================================================

JWT_SECRET_BASE64=CHANGE_ME_TO_A_LONG_RANDOM_BASE64_SECRET
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
APP_TIME_ZONE=Europe/Minsk

# Stable Docker volumes. Keep these names unchanged to preserve PostgreSQL data
# when the project folder is renamed/moved/unzipped again.
ADCRM_DB_VOLUME_NAME=backend_adcrm_pgdata
ADCRM_DOCUMENTS_VOLUME_NAME=backend_adcrm_documents

# Demo accounts are disabled. Registration creates only real PENDING users.
SEED_ENABLED=false

# Trusted SUPER_ADMIN bootstrap.
# This email is RESERVED: public registration can never claim it.
SUPER_ADMIN_EMAILS=egorchuiko7@gmail.com
SUPER_ADMIN_NAME=Егор Чуйко
# Used ONLY when the trusted admin does not yet exist. Minimum 12 chars.
# Once created, restarting backend does NOT overwrite the password.
SUPER_ADMIN_INITIAL_PASSWORD=123123123123

# Security hardening. X-Forwarded-For is ignored unless the direct peer is trusted.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
RATE_LIMIT_LOGIN_ATTEMPTS=8
RATE_LIMIT_REGISTER_ATTEMPTS=4
RATE_LIMIT_CODE_ATTEMPTS=10
RATE_LIMIT_WINDOW_MINUTES=15
SUPER_ADMIN_2FA_ENABLED=true
SUPER_ADMIN_2FA_TTL_MINUTES=10
SUPER_ADMIN_2FA_MAX_ATTEMPTS=5

# Email verification: 6-digit code, 10 min TTL, resend after 60 sec, 5 attempts.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Gmail SMTP example.
# For Gmail use an App Password, NOT the normal Google account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Timeouts in milliseconds. Port 587 uses STARTTLS.
MAIL_CONNECTION_TIMEOUT=10000
MAIL_READ_TIMEOUT=30000
MAIL_WRITE_TIMEOUT=30000
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=

GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
NOTIFICATION_CHANNEL=INTERNAL
DOCUMENT_STORAGE_DIR=./data/documents
GOTENBERG_URL=http://localhost:3001
PDF_ENABLED=true
TELEGRAM_BOT_TOKEN=

# Static print placement: inclusive period; preparation before installation.
STATIC_PLACEMENT_MINIMUM_DAYS=28
STATIC_PLACEMENT_PREPARATION_DAYS=7
